extends SceneTree

# Example integration test for DeckSystem + BattleContext + BattleEvents
# Generated by generate-test skill
#
# Pattern: test system interactions through BattleContext, verifying
# that signals fire and cross-system state stays consistent.

const BattleContextScript = preload("res://scripts/battle/battle_context.gd")
const DeckSystemScript = preload("res://scripts/systems/deck_system.gd")
const CardInstanceScript = preload("res://scripts/state/card_instance.gd")
const CardDefScript = preload("res://scripts/resources/card_def.gd")

var _failures: Array[String] = []

func _init() -> void:
	call_deferred("_run")

func _run() -> void:
	_test_context_has_deck_system()
	_test_card_draw_emits_signal()
	_test_card_moved_signal_on_discard()
	_test_deck_state_shared_across_systems()

	if _failures.is_empty():
		print("test_deck_system_integration: PASS")
		quit()
	else:
		for failure in _failures:
			push_error(failure)
		quit()

# --- Helpers --------------------------------------------------------

func _make_card(card_id: StringName) -> CardInstanceScript:
	var card_def = CardDefScript.new()
	card_def.card_id = card_id
	var card = CardInstanceScript.new()
	card.card_def = card_def
	return card

# --- Tests ----------------------------------------------------------

func _test_context_has_deck_system() -> void:
	var ctx = BattleContextScript.create_default()
	_assert(ctx.deck_state != null, "BattleContext has deck_state")
	_assert(ctx.events != null, "BattleContext has events")

func _test_card_draw_emits_signal() -> void:
	var ctx = BattleContextScript.create_default()
	var ds = DeckSystemScript.new()
	ds.setup(ctx)

	# Add a card to the draw pile
	var card = _make_card(&"signal_test_card")
	ctx.deck_state.draw_pile.append(card)

	# Listen for card_drawn signal
	var received_card = null
	ctx.events.card_drawn.connect(func(c): received_card = c)

	ds.draw_cards(1)
	_assert(received_card != null, "card_drawn signal emitted on draw")
	if received_card != null:
		_assert(received_card.card_def.card_id == &"signal_test_card", "signal carries the drawn card")

func _test_card_moved_signal_on_discard() -> void:
	var ctx = BattleContextScript.create_default()
	var ds = DeckSystemScript.new()
	ds.setup(ctx)

	var card = _make_card(&"move_test_card")
	ctx.deck_state.draw_pile.append(card)
	ds.draw_cards(1)

	# Listen for card_moved signal
	var move_from = ""
	var move_to = ""
	ctx.events.card_moved.connect(func(_card, from, to):
		move_from = from
		move_to = to
	)

	ds.discard_hand_end_turn()
	_assert(move_from == "hand", "card_moved signal has correct source zone")
	_assert(move_to == "discard", "card_moved signal has correct destination zone")

func _test_deck_state_shared_across_systems() -> void:
	var ctx = BattleContextScript.create_default()
	var ds = DeckSystemScript.new()
	ds.setup(ctx)

	# Verify deck_state is the same object across references
	_assert(ctx.deck_state == ds._ctx.deck_state, "deck_state is shared reference")

	# Add card and verify visibility from both sides
	var card = _make_card(&"shared_card")
	ctx.deck_state.draw_pile.append(card)
	_assert(ds._ctx.deck_state.draw_pile.size() == 1, "changes visible through system reference")

func _assert(condition: bool, message: String) -> void:
	if not condition:
		_failures.append(message)
