extends SceneTree

# Example unit test for DeckSystem
# Generated by generate-test skill
#
# Pattern: test a single system in isolation with minimal dependencies.
# DeckSystem requires a BattleContext (for deck_state access), so we
# create a lightweight context via BattleContext.create_default().

const BattleContextScript = preload("res://scripts/battle/battle_context.gd")
const DeckSystemScript = preload("res://scripts/systems/deck_system.gd")
const CardInstanceScript = preload("res://scripts/state/card_instance.gd")
const CardDefScript = preload("res://scripts/resources/card_def.gd")

var _failures: Array[String] = []

func _init() -> void:
	call_deferred("_run")

func _run() -> void:
	_test_draw_cards()
	_test_draw_from_empty_shuffles_discard()
	_test_discard_hand_end_turn()
	_test_resolve_card_after_use()
	_test_ethereal_goes_to_void()
	_test_exhaust_goes_to_void()

	if _failures.is_empty():
		print("test_deck_system: PASS")
		quit()
	else:
		for failure in _failures:
			push_error(failure)
		quit()

# --- Helpers --------------------------------------------------------

func _make_card(card_id: StringName) -> CardInstanceScript:
	var card_def = CardDefScript.new()
	card_def.card_id = card_id
	var card = CardInstanceScript.new()
	card.card_def = card_def
	return card

func _make_ctx_with_hand(card_ids: Array[StringName]) -> Dictionary:
	"""Returns {ctx, deck_system} with cards pre-loaded in draw pile."""
	var ctx = BattleContextScript.create_default()
	var ds = DeckSystemScript.new()
	ds.setup(ctx)
	for cid in card_ids:
		var card = _make_card(cid)
		ctx.deck_state.draw_pile.append(card)
	return {"ctx": ctx, "deck_system": ds}

# --- Tests ----------------------------------------------------------

func _test_draw_cards() -> void:
	var setup = _make_ctx_with_hand([&"card_a", &"card_b", &"card_c"])
	var ctx = setup.ctx
	var ds = setup.deck_system

	ds.draw_cards(2)
	_assert(ctx.deck_state.hand.size() == 2, "draw_cards moves cards to hand")
	_assert(ctx.deck_state.draw_pile.size() == 1, "draw_cards reduces draw pile")

func _test_draw_from_empty_shuffles_discard() -> void:
	var setup = _make_ctx_with_hand([&"only_card"])
	var ctx = setup.ctx
	var ds = setup.deck_system

	# Draw the only card, then discard it
	ds.draw_cards(1)
	_assert(ctx.deck_state.hand.size() == 1, "card drawn to hand")
	_assert(ctx.deck_state.draw_pile.is_empty(), "draw pile empty after draw")

	# Move hand to discard (simulate end turn)
	ds.discard_hand_end_turn()
	_assert(ctx.deck_state.discard_pile.size() == 1, "card moved to discard")
	_assert(ctx.deck_state.hand.is_empty(), "hand empty after discard")

	# Now draw again -- should shuffle discard into draw pile
	ds.draw_cards(1)
	_assert(ctx.deck_state.hand.size() == 1, "card drawn after shuffle")
	_assert(ctx.deck_state.discard_pile.is_empty(), "discard pile cleared after shuffle")

func _test_discard_hand_end_turn() -> void:
	var setup = _make_ctx_with_hand([&"card_x", &"card_y"])
	var ctx = setup.ctx
	var ds = setup.deck_system

	ds.draw_cards(2)
	ds.discard_hand_end_turn()
	_assert(ctx.deck_state.hand.is_empty(), "hand cleared after end turn")
	_assert(ctx.deck_state.discard_pile.size() == 2, "cards moved to discard pile")

func _test_resolve_card_after_use() -> void:
	var setup = _make_ctx_with_hand([&"played_card"])
	var ctx = setup.ctx
	var ds = setup.deck_system

	ds.draw_cards(1)
	var card = ctx.deck_state.hand[0]
	ds.resolve_card_after_use(card)
	_assert(ctx.deck_state.hand.is_empty(), "card removed from hand after use")
	_assert(ctx.deck_state.discard_pile.size() == 1, "card moved to discard after use")

func _test_ethereal_goes_to_void() -> void:
	var ctx = BattleContextScript.create_default()
	var ds = DeckSystemScript.new()
	ds.setup(ctx)

	var card = _make_card(&"ethereal_card")
	card.card_def.keywords.append(&"ethereal")
	ctx.deck_state.draw_pile.append(card)

	ds.draw_cards(1)
	ds.discard_hand_end_turn()
	_assert(ctx.deck_state.void_pile.size() == 1, "ethereal card goes to void pile")
	_assert(ctx.deck_state.discard_pile.is_empty(), "ethereal card not in discard")

func _test_exhaust_goes_to_void() -> void:
	var ctx = BattleContextScript.create_default()
	var ds = DeckSystemScript.new()
	ds.setup(ctx)

	var card = _make_card(&"exhaust_card")
	card.card_def.keywords.append(&"exhaust")
	ctx.deck_state.draw_pile.append(card)

	ds.draw_cards(1)
	ds.resolve_card_after_use(ctx.deck_state.hand[0])
	_assert(ctx.deck_state.void_pile.size() == 1, "exhaust card goes to void pile")
	_assert(ctx.deck_state.discard_pile.is_empty(), "exhaust card not in discard")

func _assert(condition: bool, message: String) -> void:
	if not condition:
		_failures.append(message)
