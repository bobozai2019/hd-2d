; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="hd2d"
run/main_scene="res://scenes/map3d/hd2d_market_plaza_lighting_lab.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GodotIQRuntime="*uid://djxgaex0epfoy"
RenderDocBridgeRuntime="*uid://bjd8e10h4on6i"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_editor_logger/plugin.cfg", "res://addons/godotiq/plugin.cfg", "res://addons/renderdoc_bridge/plugin.cfg", "res://addons/scene_bundle/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[renderdoc_bridge]

capture_path="captures/"
editor_capture_path="captures/renderdoc/editor/editor"
game_capture_path="captures/renderdoc/game/game"
renderdoccmd_path="D:/other_software/RenderDoc/renderdoccmd.exe"
auto_open_replay_ui=true
overlay_enabled=true

[rendering]

rendering_device/driver.windows="d3d12"
