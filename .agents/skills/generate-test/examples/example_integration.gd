extends SceneTree

# Example integration test for InventorySystem + GameContext + BattleEvents
# Generated by generate-test skill
#
# Pattern: test system interactions through GameContext, verifying
# that signals fire and cross-system state stays consistent.

# 示例路径 — 使用前替换为实际项目路径
const GameContextScript = preload("res://scripts/context/game_context.gd")
const InventorySystemScript = preload("res://scripts/systems/inventory_system.gd")
const ItemInstanceScript = preload("res://scripts/state/item_instance.gd")
const ItemDefScript = preload("res://scripts/resources/item_def.gd")

var _failures: Array[String] = []

func _init() -> void:
	call_deferred("_run")

func _run() -> void:
	_test_context_has_inventory_system()
	_test_card_draw_emits_signal()
	_test_item_moved_signal_on_discard()
	_test_inventory_state_shared_across_systems()

	if _failures.is_empty():
		print("test_inventory_system_integration: PASS")
		quit()
	else:
		for failure in _failures:
			push_error(failure)
		quit()

# --- Helpers --------------------------------------------------------

func _make_card(item_id: StringName) -> ItemInstanceScript:
	var item_def = ItemDefScript.new()
	item_def.item_id = item_id
	var card = ItemInstanceScript.new()
	card.item_def = item_def
	return card

# --- Tests ----------------------------------------------------------

func _test_context_has_inventory_system() -> void:
	var ctx = GameContextScript.create_default()
	_assert(ctx.inventory_state != null, "GameContext has inventory_state")
	_assert(ctx.events != null, "GameContext has events")

func _test_card_draw_emits_signal() -> void:
	var ctx = GameContextScript.create_default()
	var ds = InventorySystemScript.new()
	ds.setup(ctx)

	# Add a card to the draw pile
	var card = _make_card(&"signal_test_card")
	ctx.inventory_state.storage.append(card)

	# Listen for item_added signal
	var received_card = null
	ctx.events.item_added.connect(func(c): received_card = c)

	ds.add_items(1)
	_assert(received_card != null, "item_added signal emitted on draw")
	if received_card != null:
		_assert(received_card.item_def.item_id == &"signal_test_card", "signal carries the drawn card")

func _test_item_moved_signal_on_discard() -> void:
	var ctx = GameContextScript.create_default()
	var ds = InventorySystemScript.new()
	ds.setup(ctx)

	var card = _make_card(&"move_test_card")
	ctx.inventory_state.storage.append(card)
	ds.add_items(1)

	# Listen for item_moved signal
	var move_from = ""
	var move_to = ""
	ctx.events.item_moved.connect(func(_card, from, to):
		move_from = from
		move_to = to
	)

	ds.clear_active_items()
	_assert(move_from == "hand", "item_moved signal has correct source zone")
	_assert(move_to == "discard", "item_moved signal has correct destination zone")

func _test_inventory_state_shared_across_systems() -> void:
	var ctx = GameContextScript.create_default()
	var ds = InventorySystemScript.new()
	ds.setup(ctx)

	# Verify inventory_state is the same object across references
	_assert(ctx.inventory_state == ds._ctx.inventory_state, "inventory_state is shared reference")

	# Add card and verify visibility from both sides
	var card = _make_card(&"shared_card")
	ctx.inventory_state.storage.append(card)
	_assert(ds._ctx.inventory_state.storage.size() == 1, "changes visible through system reference")

func _assert(condition: bool, message: String) -> void:
	if not condition:
		_failures.append(message)
