extends SceneTree

# Example unit test for InventorySystem
# Generated by generate-test skill
#
# Pattern: test a single system in isolation with minimal dependencies.
# InventorySystem requires a GameContext (for inventory_state access), so we
# create a lightweight context via GameContext.create_default().

# 示例路径 — 使用前替换为实际项目路径
const GameContextScript = preload("res://scripts/context/game_context.gd")
const InventorySystemScript = preload("res://scripts/systems/inventory_system.gd")
const ItemInstanceScript = preload("res://scripts/state/item_instance.gd")
const ItemDefScript = preload("res://scripts/resources/item_def.gd")

var _failures: Array[String] = []

func _init() -> void:
	call_deferred("_run")

func _run() -> void:
	_test_add_items()
	_test_draw_from_empty_shuffles_discard()
	_test_clear_active_items()
	_test_remove_item_after_use()
	_test_ethereal_goes_to_void()
	_test_exhaust_goes_to_void()

	if _failures.is_empty():
		print("test_inventory_system: PASS")
		quit()
	else:
		for failure in _failures:
			push_error(failure)
		quit()

# --- Helpers --------------------------------------------------------

func _make_card(item_id: StringName) -> ItemInstanceScript:
	var item_def = ItemDefScript.new()
	item_def.item_id = item_id
	var card = ItemInstanceScript.new()
	card.item_def = item_def
	return card

func _make_ctx_with_hand(item_ids: Array[StringName]) -> Dictionary:
	"""Returns {ctx, inventory_system} with cards pre-loaded in draw pile."""
	var ctx = GameContextScript.create_default()
	var ds = InventorySystemScript.new()
	ds.setup(ctx)
	for cid in item_ids:
		var card = _make_card(cid)
		ctx.inventory_state.storage.append(card)
	return {"ctx": ctx, "inventory_system": ds}

# --- Tests ----------------------------------------------------------

func _test_add_items() -> void:
	var setup = _make_ctx_with_hand([&"card_a", &"card_b", &"card_c"])
	var ctx = setup.ctx
	var ds = setup.inventory_system

	ds.add_items(2)
	_assert(ctx.inventory_state.hand.size() == 2, "add_items moves cards to hand")
	_assert(ctx.inventory_state.storage.size() == 1, "add_items reduces draw pile")

func _test_draw_from_empty_shuffles_discard() -> void:
	var setup = _make_ctx_with_hand([&"only_card"])
	var ctx = setup.ctx
	var ds = setup.inventory_system

	# Draw the only card, then discard it
	ds.add_items(1)
	_assert(ctx.inventory_state.hand.size() == 1, "card drawn to hand")
	_assert(ctx.inventory_state.storage.is_empty(), "draw pile empty after draw")

	# Move hand to discard (simulate end turn)
	ds.clear_active_items()
	_assert(ctx.inventory_state.recycle_bin.size() == 1, "card moved to discard")
	_assert(ctx.inventory_state.hand.is_empty(), "hand empty after discard")

	# Now draw again -- should shuffle discard into draw pile
	ds.add_items(1)
	_assert(ctx.inventory_state.hand.size() == 1, "card drawn after shuffle")
	_assert(ctx.inventory_state.recycle_bin.is_empty(), "discard pile cleared after shuffle")

func _test_clear_active_items() -> void:
	var setup = _make_ctx_with_hand([&"card_x", &"card_y"])
	var ctx = setup.ctx
	var ds = setup.inventory_system

	ds.add_items(2)
	ds.clear_active_items()
	_assert(ctx.inventory_state.hand.is_empty(), "hand cleared after end turn")
	_assert(ctx.inventory_state.recycle_bin.size() == 2, "cards moved to discard pile")

func _test_remove_item_after_use() -> void:
	var setup = _make_ctx_with_hand([&"played_card"])
	var ctx = setup.ctx
	var ds = setup.inventory_system

	ds.add_items(1)
	var card = ctx.inventory_state.hand[0]
	ds.remove_item_after_use(card)
	_assert(ctx.inventory_state.hand.is_empty(), "card removed from hand after use")
	_assert(ctx.inventory_state.recycle_bin.size() == 1, "card moved to discard after use")

func _test_ethereal_goes_to_void() -> void:
	var ctx = GameContextScript.create_default()
	var ds = InventorySystemScript.new()
	ds.setup(ctx)

	var card = _make_card(&"ethereal_card")
	card.item_def.keywords.append(&"ethereal")
	ctx.inventory_state.storage.append(card)

	ds.add_items(1)
	ds.clear_active_items()
	_assert(ctx.inventory_state.void_pool.size() == 1, "ethereal card goes to void pile")
	_assert(ctx.inventory_state.recycle_bin.is_empty(), "ethereal card not in discard")

func _test_exhaust_goes_to_void() -> void:
	var ctx = GameContextScript.create_default()
	var ds = InventorySystemScript.new()
	ds.setup(ctx)

	var card = _make_card(&"exhaust_card")
	card.item_def.keywords.append(&"exhaust")
	ctx.inventory_state.storage.append(card)

	ds.add_items(1)
	ds.remove_item_after_use(ctx.inventory_state.hand[0])
	_assert(ctx.inventory_state.void_pool.size() == 1, "exhaust card goes to void pile")
	_assert(ctx.inventory_state.recycle_bin.is_empty(), "exhaust card not in discard")

func _assert(condition: bool, message: String) -> void:
	if not condition:
		_failures.append(message)
